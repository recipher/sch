{
  "name": "scheduler",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "remix db migrate",
    "test:e2e": "NODE_ENV=test remix test --type e2e",
    "test:coverage": "NODE_ENV=test remix test --coverage"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.31",
    "remix": "^3.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "playwright": "^1.64.1",
    "typescript": "latest"
  }
}
